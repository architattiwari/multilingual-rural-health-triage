# Copy to .env and fill in. Never commit .env.
# Only variables the code reads are listed. Everything except the secrets has a safe default.

APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO

# Database. SQLite works for local development. Production must use PostgreSQL.
DATABASE_URL=sqlite:///./triage.db
POSTGRES_PASSWORD=                  # used by docker-compose only

# Random string of at least 32 characters (production requirement). Used to key conversation token hashes.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HEADERS=false           # true only when behind a proxy you control that sets X-Forwarded-For

# Deployment specific emergency information. Leave empty rather than guessing: the app never invents a number.
EMERGENCY_CONTACT_NUMBER=
EMERGENCY_CONTACT_LABEL=
CRISIS_HELPLINE_NUMBER=

# Speech to text (OpenAI compatible /audio/transcriptions). Voice input is disabled when empty.
SPEECH_API_KEY=
SPEECH_API_BASE_URL=https://api.openai.com/v1
SPEECH_MODEL=whisper-1
SPEECH_DEFAULT_LANGUAGE=hi

# Text to speech (OpenAI compatible /audio/speech). Falls back to the device voice when empty.
TTS_API_KEY=
TTS_API_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=nova

# LLM for extra language understanding (Anthropic Messages API). The rule engine works without it.
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_EXTRACTION_ENABLED=true
TRANSLATION_LANGUAGES=              # optional comma list (for example mr,gu) served through the LLM translator

# Limits
CONVERSATION_RETENTION_HOURS=72
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_HEAVY_PER_MINUTE=12
MAX_AUDIO_BYTES=5242880
MAX_AUDIO_SECONDS=60

METRICS_ENABLED=true
METRICS_TOKEN=                      # required to scrape /metrics in production
